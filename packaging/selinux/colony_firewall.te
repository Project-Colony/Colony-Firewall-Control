policy_module(colony_firewall, 0.2.0)

########################################
#
# Colony Firewall Control
#
# On a distribution whose whole argument is SELinux enforcing, telling people
# to run `setenforce 0` would be the exact wrong advice - and it is the advice
# a project gives when it has not written this file. So this is a real module
# rather than a permissive-domain escape hatch.
#
# What the daemon actually does, which is where every rule below comes from:
#
#   * binds NFQUEUE over a netlink_netfilter socket and reads verdicts back;
#   * opens raw sockets, which is what makes Reject differ from Deny;
#   * loads BPF programs, creates and reads BPF maps, and opens perf events
#     (which is how a tracepoint program is attached);
#   * pins BPF links and maps into the bpffs at /sys/fs/bpf, so that in-kernel
#     enforcement outlives the daemon;
#   * reads /sys/kernel/btf/vmlinux and the tracefs event format files, to
#     resolve struct offsets without CO-RE;
#   * walks other processes' /proc entries to attribute a socket to a program;
#   * runs rpm(8) once per package-database generation, for provenance;
#   * runs nft(8) at start and at stop, to put its fast-allow mark into one
#     nftables set and take it out again;
#   * serves a unix socket under /run/colony-firewall to the CLI, tray and GUI.
#
# Every one of those is a separate way to be denied, and the failure modes
# differ: a denied bpf() degrades to sock_diag + /proc and the firewall keeps
# filtering, while a denied netlink_netfilter socket stops it filtering at all.
# The rules are grouped accordingly, so an operator reading an AVC can tell
# which kind of trouble they are in.
#
########################################

type colony_firewalld_t;
type colony_firewalld_exec_t;
init_daemon_domain(colony_firewalld_t, colony_firewalld_exec_t)

# /etc/colony-firewall/daemon.toml
type colony_firewall_conf_t;
files_config_file(colony_firewall_conf_t)

# /var/lib/colony-firewall - the rule store.
type colony_firewall_var_lib_t;
files_type(colony_firewall_var_lib_t)

# /run/colony-firewall - the control socket. The daemon chmod/chgrps it to
# root:colony-firewall 0660 after bind; SELinux is the second lock on the same
# door, and the one that survives a wrong umask.
type colony_firewall_runtime_t;
files_pid_file(colony_firewall_runtime_t)

# /var/log/colony-firewall
type colony_firewall_log_t;
logging_log_file(colony_firewall_log_t)

type colony_firewall_unit_file_t;
systemd_unit_file(colony_firewall_unit_file_t)

########################################
#
# Capabilities
#
# The same seven the unit grants, and no more. CAP_SYS_ADMIN is deliberately
# absent: that it is unnecessary is proven by a test that drops to uid 1000
# holding the unit's set and requires all seven attached BPF programs to load
# (`attaches_with_only_the_units_capabilities`). If an AVC here ever asks for
# sys_admin, something regressed - do not add it.
#
# The two DAC-bypass grants are the ones whose absence does not look like an
# SELinux problem, which is why they were once missing from this very file:
#
#   dac_read_search  the /proc/<pid>/fd walk that maps a socket inode to a
#                    pid. Those directories are 0500 and owned by each
#                    process's own user, so uid 0 needs the capability - and
#                    SELinux checks it separately from the file-class rules
#                    below. Without it every connection resolves to
#                    exe=<unknown> pid=0, no exe-scoped rule can match, and a
#                    fail-closed ruleset denies the whole machine's traffic.
#                    That exact outage happened on a real install (the commit
#                    that added the capability to the unit); this line is the
#                    same fix at the second lock on the same door.
#   chown            the control socket is chgrped to colony-firewall after
#                    bind. Denied, the socket stays root:root 0660 and every
#                    client is locked out with the daemon reporting healthy.
#
########################################

allow colony_firewalld_t self:capability { chown dac_read_search net_admin net_raw sys_ptrace };
allow colony_firewalld_t self:capability2 { bpf perfmon };

allow colony_firewalld_t self:process { getsched setsched signal_perms };
allow colony_firewalld_t self:fifo_file rw_fifo_file_perms;
allow colony_firewalld_t self:unix_stream_socket create_stream_socket_perms;
allow colony_firewalld_t self:unix_dgram_socket create_socket_perms;

########################################
#
# Filtering: netlink and raw sockets
#
# This is the group that must not fail. A denial here is not a degraded
# feature, it is a daemon that exits before READY=1 - and because the nftables
# ruleset is fail-closed (`ct state new queue num 0`, no `bypass`), a daemon
# that does not come up takes the machine's outbound network with it.
#
########################################

allow colony_firewalld_t self:netlink_netfilter_socket create_socket_perms;
allow colony_firewalld_t self:rawip_socket create_socket_perms;
allow colony_firewalld_t self:netlink_socket create_socket_perms;

# sock_diag, the fallback attribution source when the eBPF layer is not up.
allow colony_firewalld_t self:netlink_tcpdiag_socket { create_socket_perms nlmsg_read };

kernel_read_network_state(colony_firewalld_t)
corenet_all_recvfrom_unlabeled(colony_firewalld_t)

########################################
#
# The ring-0 layer
#
# Every rule in this group is optional in the sense that matters: a denial
# costs better attribution and in-kernel enforcement, and the daemon says so
# once at startup and carries on filtering. See `Degrade::NotPermitted`, which
# is deliberately logged at info under the automatic default precisely because
# EPERM from bpf(2) is a normal answer in a confined environment.
#
########################################

allow colony_firewalld_t self:bpf { map_create map_read map_write prog_load prog_run };
allow colony_firewalld_t self:perf_event { open read write cpu kernel tracepoint };

# BTF and the tracepoint format files: how struct offsets and the exec record
# layout are resolved at load time, since Rust/aya has no CO-RE relocations.
dev_read_sysfs(colony_firewalld_t)

optional_policy(`
	gen_require(`
		type debugfs_t;
	')
	# /sys/kernel/tracing is drwx------ root. The daemon reads it by being
	# uid 0, not by holding a capability - see the unit file. SELinux still
	# has to be told, and this is the pair of rules whose absence costs
	# process tracking while leaving DNS capture working, which is a
	# confusing way to be broken.
	allow colony_firewalld_t debugfs_t:dir search_dir_perms;
	allow colony_firewalld_t debugfs_t:file read_file_perms;
')

optional_policy(`
	gen_require(`
		type tracefs_t;
	')
	# Newer policies give tracefs its own type instead of folding it into
	# debugfs_t. Which of the two applies is a property of the release, not
	# of this daemon, so both are granted and whichever exists takes effect.
	allow colony_firewalld_t tracefs_t:dir search_dir_perms;
	allow colony_firewalld_t tracefs_t:file read_file_perms;
')

# The cgroup v2 root is opened read-only and handed to bpf() as an attach
# target. Read-only is enough and is what the unit's ProtectControlGroups
# leaves possible.
fs_search_cgroup_dirs(colony_firewalld_t)
fs_read_cgroup_files(colony_firewalld_t)
fs_getattr_cgroup(colony_firewalld_t)

# bpffs. This is what makes a deny survive `kill -9` on the daemon, so a denial
# here is the difference between enforcement that outlives the process and
# enforcement that does not - and the daemon degrades quietly to the latter.
optional_policy(`
	gen_require(`
		type bpf_t;
	')
	# manage, not create: pinning writes entries into the directory
	# (add_name + write), re-pinning after an ABI change unlinks the old
	# pins, and the pinned maps are reopened read/write on the next start.
	# The earlier { search create } grants let the daemon make the
	# directory and then denied every actual pin into it - a degrade the
	# daemon reports as quietly as any other.
	allow colony_firewalld_t bpf_t:dir manage_dir_perms;
	allow colony_firewalld_t bpf_t:file { manage_file_perms map };
	allow colony_firewalld_t bpf_t:filesystem getattr;
')

# The BPF object itself, installed to /usr/lib/colony-firewall/cfc-ebpf.o and
# left as lib_t. The loader refuses to load it at all unless it is root-owned
# and unwritable by anyone else (`vet_object`), so this read is the second
# check on the same file rather than the only one.
libs_read_lib_files(colony_firewalld_t)

# The fast-allow path. The connect hooks mark the sockets of a process the
# daemon has ruled allowed process-wide, and the shipped snippet accepts that
# mark ahead of the queue - but only for values in a set the snippet declares
# empty. The daemon runs nft(8) to put its per-start random value in and to
# flush the set again, executed in this domain like rpm below rather than
# transitioning to iptables_t, which may rewrite the whole ruleset. nft then
# opens a netlink_netfilter socket, already allowed in the filtering group
# above: it is the socket class NFQUEUE itself lives on.
#
# Five subcommands, not the two an earlier version of this comment claimed:
# `flush set` and `add element` do the work, `list set` and `list table` are
# the probe that tells a missing set from a missing table, and `get element`
# is the periodic check that the mark is still accepted after a ruleset
# reload. Nor is it twice in a daemon's life: the nft unit starts *after* the
# daemon, so arming is a retry every ten seconds until the table appears, and
# once armed the check runs every sixty. On a host where this is denied that
# is an AVC every ten seconds, for as long as the daemon runs with
# fast_allow = true - loud on purpose, but worth knowing before reading a log.
#
# A denial costs the fast path and nothing else. The daemon reports it as off
# with the reason in `cfc status`, and every connection keeps taking the queue.
#
# Fedora labels /usr/bin/nft iptables_exec_t (RHEL: /usr/sbin/nft); the same
# type covers both spellings, and the daemon tries both paths.
optional_policy(`
	gen_require(`
		type iptables_exec_t;
	')
	can_exec(colony_firewalld_t, iptables_exec_t)
')

########################################
#
# Process attribution
#
# The NFQUEUE worker gets a socket, not a pid, so answering "which program
# opened this" means walking /proc/net and then other processes' entries. This
# is the one part of the daemon that reads across every domain on the machine,
# and it is why ProtectProc=invisible is deliberately *not* set in the unit.
#
########################################

domain_read_all_domains_state(colony_firewalld_t)
kernel_read_system_state(colony_firewalld_t)
kernel_read_net_sysctls(colony_firewalld_t)

########################################
#
# Provenance
#
# The rpm backend runs `rpm -qa` once per package-database generation to build
# its path index. Executed in this domain rather than transitioning to rpm_t:
# it is a read-only query whose output is parsed here, and a transition would
# hand the child a domain that can install packages.
#
# A denial costs the provenance answer and nothing else - the query fails, the
# index stays empty, every binary reports as Unpackaged, and the daemon logs
# one warning. That is the same behaviour as a host with no package database.
#
########################################

optional_policy(`
	gen_require(`
		type rpm_exec_t;
		type rpm_var_lib_t;
	')
	can_exec(colony_firewalld_t, rpm_exec_t)
	allow colony_firewalld_t rpm_var_lib_t:dir list_dir_perms;
	allow colony_firewalld_t rpm_var_lib_t:file read_file_perms;
')

########################################
#
# Own files
#
########################################

read_files_pattern(colony_firewalld_t, colony_firewall_conf_t, colony_firewall_conf_t)
allow colony_firewalld_t colony_firewall_conf_t:dir list_dir_perms;

manage_dirs_pattern(colony_firewalld_t, colony_firewall_var_lib_t, colony_firewall_var_lib_t)
manage_files_pattern(colony_firewalld_t, colony_firewall_var_lib_t, colony_firewall_var_lib_t)
# map is not part of manage_file_perms, and SQLite in WAL mode mmaps the
# -shm file next to the database. The pragma is advisory (storage.rs tune):
# denied, the store silently keeps the slow journal mode at debug level -
# a 2.5x write regression that exists only on the module target platform
# and never surfaces as an error anywhere.
allow colony_firewalld_t colony_firewall_var_lib_t:file map;
files_var_lib_filetrans(colony_firewalld_t, colony_firewall_var_lib_t, { dir file })

manage_dirs_pattern(colony_firewalld_t, colony_firewall_log_t, colony_firewall_log_t)
manage_files_pattern(colony_firewalld_t, colony_firewall_log_t, colony_firewall_log_t)
logging_log_filetrans(colony_firewalld_t, colony_firewall_log_t, { dir file })

manage_dirs_pattern(colony_firewalld_t, colony_firewall_runtime_t, colony_firewall_runtime_t)
manage_files_pattern(colony_firewalld_t, colony_firewall_runtime_t, colony_firewall_runtime_t)
manage_sock_files_pattern(colony_firewalld_t, colony_firewall_runtime_t, colony_firewall_runtime_t)
# Raw statements, not an interface, and the history earns the verbosity.
# The runtime spelling (files_runtime_filetrans) is an unknown token in both
# CI containers' devel headers; the pid spelling exists but its deprecation
# shim leaks a literal file:line into the m4 stream and breaks the parse;
# and wrapping either in ifdef broke m4's own line counting. Three rounds,
# three different failures, all inside interface machinery this module does
# not control. var_run_t is a *type*, aliased across every rename, and raw
# allow/type_transition statements owe nothing to any header's health.
require {
	type var_run_t;
}
allow colony_firewalld_t var_run_t:dir { getattr search open read write add_name remove_name };
type_transition colony_firewalld_t var_run_t:dir colony_firewall_runtime_t;
type_transition colony_firewalld_t var_run_t:file colony_firewall_runtime_t;
type_transition colony_firewalld_t var_run_t:sock_file colony_firewall_runtime_t;

########################################
#
# Housekeeping
#
########################################

logging_send_syslog_msg(colony_firewalld_t)
init_dontaudit_use_fds(colony_firewalld_t)
# Type=notify: READY=1 is sent only once the queue and the socket are bound, so
# without this the unit never reaches active and systemd restarts it forever.
init_dgram_send(colony_firewalld_t)
miscfiles_read_localization(colony_firewalld_t)
auth_use_nsswitch(colony_firewalld_t)
userdom_dontaudit_search_user_home_dirs(colony_firewalld_t)

########################################
#
# Clients
#
# The CLI, tray and GUI run as the desktop user - unconfined_t on a default
# RHEL install - and reach the daemon through the unix socket. Granted here
# rather than left to the admin, because the alternative is every user of this
# package discovering the same AVC. Other domains should use the
# `colony_firewall_stream_connect` interface instead of copying these two
# lines.
#
########################################

optional_policy(`
	gen_require(`
		type unconfined_t;
	')
	colony_firewall_stream_connect(unconfined_t)
')
