# Colony Firewall daemon config. Install to /etc/colony-firewall/daemon.toml.
#
# RELOADING
# ---------
# `profile`, everything under [default_policy], and [provenance] are re-read
# on SIGHUP:
#
#     sudo systemctl kill -s HUP colony-firewalld
#
# The change applies without dropping a packet, and a file that fails to
# parse is rejected with the running policy left in place. Every OTHER
# section here - [nfqueue], [storage], [pause], [events], [ipc] - is bound
# at startup and needs `systemctl restart colony-firewalld`. Each section
# below says which it is.

# Named preset. Pick one of: "relaxed", "balanced", "strict".
# Omit to use "balanced" defaults.
#
#   relaxed  - Allow when nobody is subscribed, 60s prompt window.
#              Best for laptops where you don't always have the UI open.
#   balanced - Allow when nobody is subscribed, 30s window. (default)
#   strict   - Deny when nobody is subscribed, 15s window.
#              Fail-closed posture; only use if you keep the UI running.
#
# Every profile DENIES a prompt that expired unanswered. A timeout means
# the question was put to you and you did not answer it; if that granted
# access, connecting while nobody is at the keyboard would be the easiest
# way through. Set timeout_action explicitly below if you disagree.
#
# How profile and [default_policy] combine: the profile (or "balanced" when
# omitted) provides the base values, and each field you explicitly set under
# [default_policy] overrides just that field. Fields you leave commented out
# keep the profile's value. So `profile = "strict"` plus a single
# prompt_timeout_secs below is strict with a longer window, not balanced.
# An unrecognized name warns and falls back to the "balanced" base.
#
# Reloads on SIGHUP.
profile = "balanced"

# Reloads on SIGHUP. A changed prompt_timeout_secs applies to the next
# prompt; prompts already waiting keep the deadline they were created with.
# [default_policy]
# # Each field overrides the profile's value for that one field only.
# # What to do when no rule matches and NOTHING is subscribed to prompts -
# # no GUI, no `cfc prompts`. Nobody is asked; this is applied directly.
# # "Reject" is accepted here but behaves as "Deny" (no refusal is sent).
# no_ui_action = "Allow"
# # What to do if a prompt was shown but expired unanswered. Every profile
# # sets this to "Deny"; override only if you want an unanswered question
# # to grant access. Same caveat about "Reject".
# timeout_action = "Deny"
# # How long a prompt waits for an answer, in seconds.
# prompt_timeout_secs = 30

# Needs a restart (the queue is bound once, at startup).
[nfqueue]
# NFQUEUE number. Must match the `queue num N` in the nftables/iptables rule
# that enqueues packets. If they disagree, packets queue to a number nobody
# consumes - which under the shipped fail-closed rule is a total outbound
# lockout. Bind failure is fatal: the daemon exits non-zero rather than
# running while enforcing nothing.
queue_num = 0
# Kernel queue length: how many packets may wait for a verdict before the
# queue overflows. Raise it on a busy host that prompts a lot; each queued
# packet costs kernel memory.
queue_max_len = 4096
# What the KERNEL does with packets when this queue overflows: false drops
# them (fail-closed, default), true lets them through unfiltered
# (fail-open).
#
# Not to be confused with the `bypass` keyword on the nftables rule, which
# decides what happens when NO daemon is attached to the queue at all. This
# setting only applies while the daemon is running. See
# docs/TROUBLESHOOTING.md for the full matrix.
fail_open = false

# Needs a restart.
[storage]
# SQLite database holding both the rules and the verdict event log. The
# daemon creates it on first start; the directory is provided by the unit's
# StateDirectory=.
path = "/var/lib/colony-firewall/rules.db"

# Needs a restart.
[pause]
# Default duration for `cfc pause` when no `--for` is given, in seconds.
# (10 minutes.) Any request is clamped to 24 hours, and the daemon reports
# the real resume time back to the caller.
#
# Pausing is not a kill switch: rules are still evaluated, so explicit Deny
# and Reject rules keep blocking. It only stops PROMPTING, and lets flows
# that matched no rule through.
default_secs = 600

# Needs a restart.
[events]
# Retention for the verdict log that backs `cfc log`, as a row cap rather
# than a time window: the oldest rows beyond this many are pruned, about
# once a minute. Roughly 200 bytes a row, so the default is a few tens of
# MB. Set it higher if you want a longer history and can spare the disk.
#
# Writing happens off the packet path through a bounded queue, so a slow
# disk never delays a verdict; if that queue fills, rows are dropped and
# the loss is logged. Blocked connections are additionally logged to the
# journal, whether or not the row reaches disk.
max_rows = 100000

# Reloads on SIGHUP.
[provenance]
# Answer "does this binary still match what the distribution installed?"
# for every process the daemon prompts or reports about, and show it next to
# the process in the GUI, the tray and `cfc prompts`:
#
#   package  curl 8.21.0-1 (verified)          matches the package record
#   package  curl 8.21.0-1 — MODIFIED since install
#   package  not from a package                nothing owns this path
#
# This is the Linux answer to Windows Firewall Control's "Signed: Yes
# (Canon Inc.)" line, and a stricter question than a signature: the digest
# compared is the one taken from /proc/<pid>/exe, i.e. the bytes the kernel
# actually mapped, while the package database describes the file on disk.
# MODIFIED therefore means the running binary is not the one the package
# shipped - patched, replaced, or swapped under a live process. Treat it as
# a real finding, not a formatting quirk.
#
# BACKENDS
#   pacman (/var/lib/pacman/local) - full verification against the sha256
#     digests in each package's mtree.
#   dpkg (/var/lib/dpkg/info) - package NAME only, rendered "(unverified)".
#     dpkg records MD5 and nothing else, which is not a hash worth asserting
#     integrity with, so the daemon names the owner and declines to vouch
#     for the bytes.
#   Neither present - every process reads "unknown" and the line is hidden.
#
# COST
# The first lookup after start (or after any pacman/dpkg transaction) builds
# a path -> package index by reading every installed package's file list:
# about 200ms and ~10MB of memory for a 1300-package desktop, done lazily
# off the first lookup, never on the packet path. After that a newly-seen
# binary costs one gzip parse of its own package's mtree, and repeat lookups
# are served from a cache keyed by the executable's (device, inode, mtime).
# A build slower than a second logs a warning telling you about this switch.
#
# Set false to skip all of it; process resolution and rule matching are
# unaffected either way.
enabled = true

# Needs a restart (the socket is secured once, right after bind).
[ipc]
# Access control for the gRPC control socket (/run/colony-firewall/cfc.sock).
#
# TRUST MODEL
# -----------
# The daemon is root and drives the packet filter, so the control socket is
# the whole attack surface. Two layers guard it:
#
#   1. The socket file. After bind the daemon chowns it to root:<group> and
#      chmods it 0660, so the kernel refuses connect(2) to anyone outside
#      the group. Group membership IS the credential - there is no in-band
#      authentication, no per-user identity, no password.
#   2. Peer credentials. Every connection carries SO_PEERCRED, and the
#      daemon logs the calling uid/pid for every mutating RPC. Mutating
#      RPCs (UpsertRule, DeleteRule, SetPaused, SubmitVerdict) need uid 0
#      or a socket that is genuinely group-gated. Read-only RPCs
#      (ListRules, GetStatus, ListEvents, StreamConnections, StreamPrompts)
#      are open to any peer that got through layer 1.
#
# Say it plainly: EVERY MEMBER OF THIS GROUP IS FULLY TRUSTED. Membership
# grants the ability to allow or deny any traffic on this host. This is not
# a multi-user privilege boundary - add only administrators of this machine.
#
# One exception to "any group member can do anything": prompt answers.
# Prompts are addressed by the uid that owns the process they are about.
# A StreamPrompts subscription is only handed a prompt when the subscriber's
# uid matches that owner, and only a peer a prompt was actually handed to
# may answer it - so one desktop session is neither shown nor able to answer
# another session's prompt. Two caveats, both deliberate:
#
#   - uid 0 is exempt on both counts: root sees and may answer everything.
#     A prompt for a root-owned process (a system daemon) therefore reaches
#     only root subscribers; with no root UI connected it is resolved by
#     [default_policy] no_ui_action instead of being shown to a user.
#   - A flow the daemon could not attribute to any uid (the process exited
#     before /proc could be read) is offered to every session, because
#     nobody owns it and restricting it would mean nobody is ever asked.
#
# If the group does not exist the daemon does NOT fail to start: it warns,
# leaves the socket root-only (0600), and only the root CLI can connect.
# Create it with the shipped sysusers fragment
# (/usr/lib/sysusers.d/colony-firewall.conf, then `systemd-sysusers`) or by
# hand (`groupadd -r colony-firewall`), then
# `usermod -aG colony-firewall <your-user>` and log back in.
group = "colony-firewall"

# Whether a non-root peer must reach the daemon through a genuinely
# group-gated socket before it may change anything. Leave this true. Set it
# to false only if you gate the socket some other way (e.g. filesystem
# ACLs); with it false, any process that manages to connect can rewrite
# your firewall rules.
require_group = true
