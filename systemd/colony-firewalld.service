[Unit]
Description=Colony Firewall Control daemon
Documentation=https://github.com/Project-Colony/Colony-Firewall-Control
# Ordered BEFORE network-pre.target, the systemd convention for firewalls:
# every network-configuration service (NetworkManager, systemd-networkd,
# dhcpcd, ...) is After=network-pre.target, so this daemon is up and
# listening on the queue before any interface gets configured. There is
# no window at boot where the network exists but filtering does not.
# (During early boot no UI is connected yet, so unmatched flows resolve
# via no_ui_action; `cfc rules bootstrap-defaults` covers DHCP, DNS and
# NTP so a strict profile still boots.)
Before=network-pre.target
Wants=network-pre.target

[Service]
# Type=notify: the daemon sends READY=1 only after both the NFQUEUE and
# the control socket are bound, so "started" means "actually filtering";
# a failed bind exits non-zero before READY and Restart=on-failure retries.
# WATCHDOG=1 heartbeats are sent from the main process (NotifyAccess=main)
# and stop if the worker thread wedges, so WatchdogSec restarts the daemon.
Type=notify
NotifyAccess=main
WatchdogSec=30
ExecStart=/usr/bin/colony-firewalld --config /etc/colony-firewall/daemon.toml
Restart=on-failure
RestartSec=2
# Final backstop only. On SIGTERM the daemon asks the NFQUEUE worker to
# leave its loop and then shuts the tokio runtime down with its own short
# grace, so a healthy stop completes in well under a second; this bounds
# the pathological case instead of letting systemd's 90s default turn every
# restart into a minute and a half of "timed out, killing".
TimeoutStopSec=15

# Privileges
#
# CAP_NET_ADMIN  NFQUEUE, and the cgroup_skb attach.
# CAP_NET_RAW    the raw sockets that make Reject differ from Deny.
# CAP_SYS_PTRACE process attribution reads other processes' /proc entries.
# CAP_BPF        bpf(2): loading programs and creating/reading maps.
# CAP_PERFMON    perf_event_open(2), which is how a tracepoint program is
#                actually attached (the two sched_process_* programs).
# CAP_CHOWN      chgrp on the control socket.
# CAP_DAC_READ_SEARCH  reading /proc/<pid>/fd of processes owned by other
#                users, which is the second half of attribution: sock_diag
#                gives an inode, and finding which process holds it means
#                walking every /proc/*/fd. Those directories are 0500 and owned
#                by the process's own user.
#
# Those last two look unnecessary because the daemon runs as uid 0, and they
# are the two that matter most. Root's "implicit DAC bypass" is not implicit at
# all - it *is* CAP_DAC_OVERRIDE / CAP_DAC_READ_SEARCH - so a bounding set that
# omits them drops them from root too. Both failures found by installing this
# unit and watching it, not by any of the 640 tests:
#
#   without CAP_CHOWN            chown(2) answers EPERM, the socket stays
#                                root-only, and every client - CLI, tray, GUI -
#                                silently cannot connect. One WARN at startup.
#   without CAP_DAC_READ_SEARCH  every connection resolves to `exe=<unknown>
#                                pid=0`, so no exe-scoped rule can ever match
#                                and a fail-closed ruleset denies the whole
#                                machine's traffic. No warning at all: from the
#                                daemon's side, nothing failed.
#
# CAP_DAC_OVERRIDE is deliberately NOT granted: read-and-search is all this
# needs, and the write half is what would let the daemon edit files it does not
# own.
#
# CAP_BPF and CAP_PERFMON are granted unconditionally. `[ebpf] enabled`
# defaults to `auto`, so on a capable kernel the ring-0 layer comes up by
# itself; granting the capabilities here rather than making operators edit the
# unit is what makes that automatic. On a host that cannot use them they are
# simply never exercised.
#
# On kernels older than 5.8 neither capability exists and bpf(2) requires
# CAP_SYS_ADMIN instead. This unit does not add that - it would hand the daemon
# most of root, to enable a feature whose kernel requirements (ring buffers,
# BTF) start at 5.8 anyway. On such a kernel the load fails, the daemon warns
# and carries on without it, which is the correct outcome.
#
# That CAP_SYS_ADMIN is genuinely unnecessary is tested, not assumed:
# `attaches_with_only_the_units_capabilities` drops to a non-root uid holding
# exactly this set, asserts CAP_SYS_ADMIN is absent from its own effective set,
# and requires all three programs to attach.
#
# One thing that test surfaced and this unit relies on without saying so: the
# daemon runs as **uid 0** (there is no User= here), and it needs that for
# more than capabilities. /sys/kernel/tracing is drwx------ root, so reading
# the tracepoint id/format files is a discretionary-access question that no
# capability in the list above answers - root's implicit DAC bypass does.
# Adding User= to this unit, without also granting CAP_DAC_OVERRIDE, would
# silently cost the daemon both tracepoints (process tracking) while leaving
# the cgroup program (DNS capture) working.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_PTRACE CAP_BPF CAP_PERFMON CAP_CHOWN CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_PTRACE CAP_BPF CAP_PERFMON CAP_CHOWN CAP_DAC_READ_SEARCH
NoNewPrivileges=true

# Filesystem
ProtectSystem=strict
ProtectHome=true
# /sys/fs/bpf is listed because ProtectKernelTunables below remounts /sys
# read-only, and the enforcement links are *pinned* into the bpffs mounted
# there. Without this line the pin fails with EROFS, the daemon falls back to
# process-lifetime links, and `kill -9` on this unit lifts every in-kernel deny
# it holds - which is the one thing that layer exists to prevent. The daemon
# only ever creates /sys/fs/bpf/colony-firewall/; it writes nothing else there.
ReadWritePaths=/var/lib/colony-firewall /run/colony-firewall /var/log/colony-firewall /sys/fs/bpf
RuntimeDirectory=colony-firewall
RuntimeDirectoryMode=0755
StateDirectory=colony-firewall
StateDirectoryMode=0750
LogsDirectory=colony-firewall

# Sandboxing
PrivateTmp=true
# ProtectKernelTunables is deliberately OFF, and replaced by hand below.
#
# It does the right thing and one wrong thing: it remounts /sys read-only
# *recursively*, which catches the bpffs mounted at /sys/fs/bpf - and that is
# where the in-kernel enforcement links are pinned. `ReadWritePaths=/sys/fs/bpf`
# does not win against it (tried, systemd 261: the bpffs stays ro), and neither
# does `BindPaths=` (the read-only remount stacks on top of the bind). The
# observable result was `enforcement=process` instead of `enforcement=pinned`,
# logged at info, on a machine that was perfectly capable of pinning - which is
# to say the "denials survive kill -9" property was silently absent.
#
# The ReadOnlyPaths below reproduce what ProtectKernelTunables covers, minus
# the one directory that has to be writable. Every entry of /sys is listed
# individually rather than /sys as a whole, because listing the parent and then
# excepting the child is exactly what does not work: systemd makes the parent
# writable to reach it.
#
# What this still protects, verified inside the unit's namespace: /proc/sys is
# read-only, /sys/kernel is read-only, and /sys/kernel/btf and
# /sys/kernel/tracing remain readable - which the eBPF loader needs.
#
# A new top-level directory in a future kernel's sysfs would be writable to
# this unit until it is added here. That is the cost of the trade, and it is
# smaller than losing the pin.
#
# EVERY path is prefixed with "-", and that is not defensive tidiness. Without
# it, systemd treats a missing path as a fatal error and the unit dies at
# 226/NAMESPACE before the daemon is ever executed:
#
#   Failed to set up mount namespacing: /sys/fs/resctrl: No such file or directory
#   Failed at step NAMESPACE spawning /usr/bin/colony-firewalld
#
# Reported from a real Arch Colony install on 2026-08-21. Almost none of these
# paths is guaranteed: /sys/fs/resctrl needs CONFIG_X86_CPU_RESCTRL *and* a CPU
# exposing RDT, /sys/fs/btrfs, ext4, fuse, pstore and virtiofs each need their
# subsystem present, /sys/hypervisor is Xen-only, /proc/acpi needs ACPI. This
# unit was written against a kernel that happened to have them all.
#
# ProtectKernelTunables=yes, which these lines replace, tolerates missing paths
# on its own. Reimplementing it by hand meant reimplementing that too, and this
# is the half that was missed.
ProtectKernelTunables=false
ReadOnlyPaths=-/proc/sys -/proc/sysrq-trigger -/proc/irq -/proc/acpi -/proc/fs
ReadOnlyPaths=-/sys/block -/sys/bus -/sys/class -/sys/dev -/sys/devices -/sys/firmware
ReadOnlyPaths=-/sys/hypervisor -/sys/kernel -/sys/module -/sys/power
ReadOnlyPaths=-/sys/fs/btrfs -/sys/fs/cgroup -/sys/fs/ext4 -/sys/fs/fuse
ReadOnlyPaths=-/sys/fs/pstore -/sys/fs/resctrl -/sys/fs/tmpfs -/sys/fs/virtiofs
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
# Pure-Rust daemon; nothing JITs or needs writable+executable memory.
#
# This stays on with the eBPF backend enabled. MemoryDenyWriteExecute is a
# per-process mmap/mprotect restriction, and the BPF JIT does not run in this
# process at all - bpf(2) hands the kernel an instruction array, the verifier
# and JIT run kernel-side, and the resulting machine code lives in kernel
# memory that this unit's address-space policy has no bearing on. Likewise
# LockPersonality: personality(2) is never called here, by the daemon or by
# aya.
MemoryDenyWriteExecute=true
# Biggest RCE-blast-radius reduction available: seccomp-filter syscalls to
# the service baseline. @network-io is not a systemd syscall set; socket
# syscalls are already in @system-service. Deliberately NOT setting
# ProtectProc=invisible: process attribution walks other processes' /proc
# entries (/proc/net inode -> /proc/*/fd).
#
# bpf and perf_event_open are listed EXPLICITLY, by name, because
# @system-service does NOT cover either of them. Verified with
# `systemd-analyze syscall-filter` on systemd 261:
#
#   bpf              is in @privileged (and @known), not @system-service
#   perf_event_open  is in @debug      (and @known), not @system-service
#
# There is no @bpf set - if you go looking for one, that is why. Without these
# two lines every bpf(2) call returns EPERM under this unit and the daemon
# degrades to sock_diag + /proc, silently as far as the operator is concerned
# apart from one warning at startup.
#
# Naming the two syscalls rather than adding @privileged or @debug is
# deliberate and is the whole point: @privileged would also hand back mount,
# chroot and the setuid family, and @debug would hand back ptrace and
# process_vm_readv - a much larger surface than "load a verified program and
# attach it to a tracepoint" needs. perf_event_open is required because that
# is how a tracepoint program is attached; the cgroup_skb and cgroup_sock_addr
# programs go through bpf(BPF_LINK_CREATE) alone. Pinning is bpf(BPF_OBJ_PIN),
# also covered by the `bpf` entry.
#
# Listing them costs nothing when the eBPF backend is off: an allowed syscall
# that is never called is not an attack surface, and CAP_BPF is a separate gate
# on making it succeed.
#
# One more thing this set has to cover, which is not obvious from the list: on
# an rpm host the provenance backend runs `rpm -qa` once per package-database
# generation. fork/clone/execve are already in @system-service, and everything
# else about this unit is compatible with that child - ProtectSystem=strict
# leaves /var/lib/rpm readable, and rpm needs no writable-executable memory. If
# it ever is not compatible, the failure is a warning and an empty provenance
# index, never a failure to filter.
SystemCallFilter=@system-service
SystemCallFilter=bpf perf_event_open
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# The control socket is chmod/chgrp'd explicitly by the daemon after bind
# (root:colony-firewall 0660); a tight umask closes the pre-chmod window.
UMask=0077

# Required for NFQUEUE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET

[Install]
WantedBy=multi-user.target
