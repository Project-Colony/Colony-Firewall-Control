# Maintainer: MotherSphere <linhajahad@gmail.com>
#
# Development / VCS variant of colony-firewall-control.
#
# Usage (from anywhere):
#     mkdir /tmp/cfc-git && cp pkg/PKGBUILD-git /tmp/cfc-git/PKGBUILD
#     cp pkg/colony-firewall-control.install /tmp/cfc-git/
#     cd /tmp/cfc-git && makepkg -si
#
# To build from your local checkout instead of GitHub (fast iteration,
# uses your working tree's HEAD), point _giturl at the repo root, e.g.:
#     _giturl="git+file:///home/you/Colony-Firewall-Control"

pkgname=colony-firewall-control-git
pkgver=r0.0000000
pkgrel=1
pkgdesc="Application-aware outbound firewall for Linux, written in Rust (git version)"
arch=('x86_64')
url="https://github.com/Project-Colony/Colony-Firewall-Control"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'nftables' 'libxkbcommon' 'wayland')
makedepends=('cargo' 'protobuf' 'pkgconf' 'git')
optdepends=(
    'libnotify: desktop notifications on new prompts'
    'libx11: run the GUI in X11/XWayland sessions'
)
provides=('colony-firewall-control')
conflicts=('colony-firewall-control')
backup=('etc/colony-firewall/daemon.toml')
install=colony-firewall-control.install
_giturl="git+https://github.com/Project-Colony/Colony-Firewall-Control.git"
source=("colony-firewall-control::$_giturl")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/colony-firewall-control"
    # v0.1.0-5-gabc1234 -> 0.1.0.r5.gabc1234 ; falls back to rN.hash before
    # the first tag.
    git describe --long --tags 2>/dev/null \
        | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
        || printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$srcdir/colony-firewall-control"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$srcdir/colony-firewall-control"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --workspace --profile release --locked
}

check() {
    cd "$srcdir/colony-firewall-control"
    export RUSTUP_TOOLCHAIN=stable
    # Dev profile: the release profile sets panic=abort, which the libtest
    # harness cannot use.
    cargo test --workspace --locked --no-fail-fast
}

package() {
    cd "$srcdir/colony-firewall-control"

    # Binaries
    install -Dm755 target/release/colony-firewalld "$pkgdir/usr/bin/colony-firewalld"
    install -Dm755 target/release/colony-firewall  "$pkgdir/usr/bin/colony-firewall"
    install -Dm755 target/release/cfc              "$pkgdir/usr/bin/cfc"

    # systemd units
    install -Dm644 systemd/colony-firewalld.service \
        "$pkgdir/usr/lib/systemd/system/colony-firewalld.service"
    install -Dm644 systemd/colony-firewall-nft.service \
        "$pkgdir/usr/lib/systemd/system/colony-firewall-nft.service"

    # sysusers: creates the 'colony-firewall' group for gRPC socket access
    install -Dm644 systemd/colony-firewall.sysusers \
        "$pkgdir/usr/lib/sysusers.d/colony-firewall.conf"

    # Config (protected by backup=)
    install -Dm644 systemd/daemon.toml.sample \
        "$pkgdir/etc/colony-firewall/daemon.toml"

    # nftables snippet, loaded by colony-firewall-nft.service
    install -Dm644 systemd/nftables-snippet.conf \
        "$pkgdir/usr/share/colony-firewall/nftables-snippet.conf"

    # Desktop integration
    install -Dm644 pkg/colony-firewall.desktop \
        "$pkgdir/usr/share/applications/colony-firewall.desktop"
    install -Dm644 pkg/colony-firewall-autostart.desktop \
        "$pkgdir/etc/xdg/autostart/colony-firewall.desktop"
    install -Dm644 pkg/colony-firewall.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/colony-firewall.svg"

    # Docs & license
    install -Dm644 README.md            "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 docs/ARCHITECTURE.md "$pkgdir/usr/share/doc/$pkgname/ARCHITECTURE.md"
    install -Dm644 docs/HARDENING.md    "$pkgdir/usr/share/doc/$pkgname/HARDENING.md"
    install -Dm644 LICENSE              "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # Shell completions and the man page are generated by the binary we
    # just built (`cfc completions <shell>` / `cfc man`), so they can never
    # drift from the actual CLI surface. Neither subcommand talks to the
    # daemon, so this works inside a clean build chroot.
    local _gen="$srcdir/generated"
    install -d "$_gen"
    target/release/cfc completions bash >"$_gen/cfc.bash"
    target/release/cfc completions zsh  >"$_gen/_cfc"
    target/release/cfc completions fish >"$_gen/cfc.fish"
    # One page per subcommand, so the cross references inside cfc.1
    # (cfc-rules(1), cfc-prompts(1), ...) actually resolve.
    target/release/cfc man --dir       "$_gen/man"

    install -Dm644 "$_gen/cfc.bash" "$pkgdir/usr/share/bash-completion/completions/cfc"
    install -Dm644 "$_gen/_cfc"     "$pkgdir/usr/share/zsh/site-functions/_cfc"
    install -Dm644 "$_gen/cfc.fish" "$pkgdir/usr/share/fish/vendor_completions.d/cfc.fish"
    install -Dm644 -t "$pkgdir/usr/share/man/man1" "$_gen"/man/*.1
}
