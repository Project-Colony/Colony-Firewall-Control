# pacman install scriptlet for colony-firewall-control.

post_install() {
    cat <<'EOF'
==> Colony Firewall Control - first run:

    1. Enable the daemon and the persistent nftables rules:
           systemctl enable --now colony-firewalld colony-firewall-nft
       (colony-firewall-nft loads 'table inet colony_firewall'; it is
        fail-closed while loaded, and PartOf= the daemon, so stopping
        the daemon also removes the table cleanly.)

    2. Let your desktop user talk to the daemon socket:
           usermod -aG colony-firewall <your-user>
       then log out/in. The 'colony-firewall' group is created by
       systemd-sysusers from /usr/lib/sysusers.d/colony-firewall.conf
       (applied automatically by the pacman sysusers hook).

    3. Seed sensible default rules:
           cfc rules bootstrap-defaults

==> The GUI autostarts for all desktop users via
    /etc/xdg/autostart/colony-firewall.desktop; per-user opt-out: copy it
    to ~/.config/autostart/ and set Hidden=true.
==> Config: /etc/colony-firewall/daemon.toml (kept on upgrades).
EOF
}

post_upgrade() {
    cat <<'EOF'
==> colony-firewall-control upgraded.
    Changes: /usr/share/doc/colony-firewall-control/README.md and
    https://github.com/Project-Colony/Colony-Firewall-Control/blob/main/CHANGELOG.md
    Restart to apply:  systemctl restart colony-firewalld
EOF
}

pre_remove() {
    # Stop enforcement BEFORE the binaries and the snippet disappear, so
    # the fail-closed NFQUEUE table can never outlive the daemon and
    # blackhole all new outbound traffic.
    #
    # The inbound pair belongs here too, and used not to be. Removing the
    # package on a host where the inbound chain had been enabled left
    # 'table inet colony_firewall_inbound' loaded with nothing left to manage
    # it — on a machine reached over the network, exactly the lockout that
    # keeping inbound in its own opt-in unit was meant to avoid. pkg/colony.json
    # has always taken both down; this is the pacman side catching up.
    systemctl disable --now \
        colony-firewall-nft-inbound.service \
        colony-firewall-nft.service \
        colony-firewalld.service 2>/dev/null || true
    nft delete table inet colony_firewall 2>/dev/null || true
    nft delete table inet colony_firewall_inbound 2>/dev/null || true

    # Stopping the daemon no longer stops CFC. The pinned programs are
    # evaluated by the kernel on their own and keep returning EPERM to
    # processes started after the daemon died — the property the pinning
    # exists for, and the reason removal has to be explicit about it.
    #
    # This package ships no eBPF object, so ordinarily there is nothing here.
    # A distribution that ships one separately (Arch Colony does) leaves pins
    # behind that this would otherwise orphan.
    rm -rf /sys/fs/bpf/colony-firewall
}
